# Copy to .env and adjust as needed. Docker Compose reads this automatically.

# --- OpenRouter model runtime -------------------------------------------
# Create a key at https://openrouter.ai/keys and put it in your local .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Put authorized manuals, notes, and licensed books under ./knowledge.
SENTINEL_KNOWLEDGE_DIR=./knowledge

# --- Execution limits ----------------------------------------------------
SENTINEL_TOOL_TIMEOUT_S=180
SENTINEL_MAX_ITERATIONS=40
SENTINEL_MAX_OUTPUT_BYTES=5242880
SENTINEL_MAX_CONCURRENT_TASKS=1

# --- Safety policy ---------------------------------------------------------
# When true (default), any operation registered as INTRUSIVE requires an
# explicit interactive approval before it runs. Do not set to false outside
# of a fully unattended, already-reviewed lab script.
SENTINEL_REQUIRE_APPROVAL=true

# When true, Sentinel may look up public advisory/PoC references over the
# network during investigation. Defaults to false (fully offline posture).
SENTINEL_ALLOW_NETWORK_LOOKUPS=false

# --- Local data path -------------------------------------------------------
SENTINEL_DATA_DIR=./data
